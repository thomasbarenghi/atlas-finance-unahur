# Variables públicas del cliente (Next.js). Solo NEXT_PUBLIC_*; nunca secretos.
# Copiá este archivo a `.env.local` y ajustá los valores.

# URL base del API (NestJS). En local: http://localhost:3001/api
# Si se omite, el cliente usa el valor relativo "/api".
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backend en memoria (lib/mocks). Default: true (si no se define).
# Poné "false" para consumir el API real (requiere NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_USE_MOCKS=true

# Mantiene los mocks para los datos pero manda el asistente al API real
# (DeepSeek) en el servidor. Requiere NEXT_PUBLIC_API_URL.
# true = asistente contra el API; false/omitido = asistente mockeado.
NEXT_PUBLIC_ASSISTANT_LIVE=true
