{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "lib/test/**/*.ts",
    "lib/test/**/*.tsx",
    "vitest.setup.ts",
    "vitest-env.d.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "android"]
}
