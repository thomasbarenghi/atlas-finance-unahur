NODE_ENV=development
PORT=3001

# Base de datos (Supabase / Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_SSL=true
# Pool de conexiones por instancia. En serverless (Vercel) conviene chico para no
# agotar el pooler de Supabase ("max clients reached"). Si usás el *transaction
# pooler* de Supabase (puerto 6543), este valor puede quedar bajo igual.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=15000

# JWT
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=30

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend (CORS). CORS_ORIGIN admite varios orígenes separados por coma
# (p. ej. localhost y el dominio de producción del cliente).
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_NATIVE=capacitor://localhost,http://localhost,https://localhost

# IA (DeepSeek por defecto: https://api.deepseek.com, OpenAI-compatible)
# La API key SIEMPRE vive en el servidor; nunca exponerla con NEXT_PUBLIC_* en el cliente.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
# Solo desarrollo: usuario demo usado por la ruta dev del asistente (sin JWT).
AI_DEV_USER_EMAIL=demo@atlassfin.app

# Moneda única del sistema (v0.3). La app opera con una sola moneda.
DEFAULT_CURRENCY=ARS

# Tests de integración (e2e). Base local separada; nunca usar la de dev/prod.
# Si se omite, la suite usa postgresql://localhost:5432/atlas_finance_test
TEST_DATABASE_URL=postgresql://localhost:5432/atlas_finance_test

# Solo desarrollo/test: token opcional para los endpoints /api/dev/database/*.
# Si queda vacío, solo se exige NODE_ENV=development|test. Nunca setear en producción.
DEV_DATABASE_TOKEN=
